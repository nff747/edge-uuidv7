  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "keywords": [
    "uuid",
    "uuidv7",
    "edge",
    "zero-allocation",
    "monotonic",
    "fast"
  ],
  "author": "nff747",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nff747/edge-uuidv7.git"
  },
  "bugs": {
    "url": "https://github.com/nff747/edge-uuidv7/issues"
  },
  "homepage": "https://github.com/nff747/edge-uuidv7#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
